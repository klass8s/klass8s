{
    "name": "tequila/klass8s",
    "description": "Define Kubernetes manifests as PHP classes",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Petr Buchin",
            "email": "petrbuchyn@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/event-dispatcher": "^1.0",
        "symfony/yaml": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/process": "^8.0",
        "tequila/k8schema": "*",
        "tequila/proximity": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Klass8s\\": "src/",
            "Klass8s\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs:check": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer check",
        "tools:update": "composer update -d tools/php-cs-fixer --no-scripts",
        "test": "./vendor/bin/phpunit --bootstrap=tests/bootstrap.php tests",
        "test:bundle": "./vendor/bin/phpunit --bootstrap=tests/bootstrap.php tests/Bundle"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.tequila.dev/"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    }
}
