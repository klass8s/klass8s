namespace Klass8s\App;

use K8Schema\Apimachinery\Pkg\Apis\Meta\V1\ObjectMeta;
use K8Schema\APIResourceInterface;
use Klass8s\Bundle\DependencyInjection\AppConfig;
use Klass8s\Bundle\DependencyInjection\ManifestConfig;
use Klass8s\Config\ConfigAwareTrait;
use Klass8s\Manifest\FullNameAwareInterface;
use Klass8s\Manifest\ManifestInterface;
use Klass8s\Manifest\ManifestNameResolver;
use Klass8s\Manifest\MetadataAwareInterface;
use Klass8s\Manifest\MetadataConfigurator;
use Klass8s\Registry\ManifestRegistry;

abstract class AbstractApp implements AppInterface, ReadsResourceFiles
{
    use ConfigAwareTrait;

    protected string $alias;
    protected int $deployPriority = 0;

    __construct(protected ManifestRegistry $manifestRegistry) {}

    alias(): string => $this->alias;

    setAlias(string $alias): void => $this->alias = $alias;

    deployPriority(): int => $this->deployPriority;

    setDeployPriority(int $deployPriority): void => $this->deployPriority = $deployPriority;

    manifestConfig(ManifestInterface $manifest): ManifestConfig {
        $configKey = $manifest instanceof FullNameAwareInterface
            ? $manifest->fullName()
            : $manifest->computedShortName;
        /** @var AppConfig|array{} $config An app configured nowhere has an empty config. */
        $config = $this->config;

        return $config['manifests'][$configKey] ?? [];
    }

    resourceNameFromManifestClass(class<ManifestInterface> $manifestClass, ?class<ManifestInterface> $classToValidateAgainst = null): string {
        $name = ManifestNameResolver::resourceNameFromManifestClass($manifestClass, $this->alias);
        if (null !== $classToValidateAgainst && !is_a($manifestClass, $classToValidateAgainst, true)) {
            throw new \LogicException(sprintf('Manifest class "%s" is not a subclass of "%s".', $manifestClass, $classToValidateAgainst));
        }
        if (!$this->ownsManifestClass($manifestClass)) {
            throw new \InvalidArgumentException(sprintf('App "%s" does not own manifest class "%s".', $this->alias, $manifestClass));
        }

        return $name;
    }

    resourceNameFromShortName(string $shortName): string
        => ManifestNameResolver::resourceNameFromShortNameAndPrefix($shortName, $this->alias);

    readFile(string $filePath): string {
        $path = dirname((string) new \ReflectionObject($this)->getFileName()) . '/Resources/' . ltrim($filePath, '/');
        $contents = file_exists($path) ? file_get_contents($path) : false;
        if (false === $contents) {
            throw new \InvalidArgumentException(
                sprintf('File "%s" does not exist', $path),
            );
        }

        return $contents;
    }

    ownsManifestClass(class<ManifestInterface> $manifestClass): bool
        => null !== $this->getManifestByClass($manifestClass);

    getManifestByClass<T of ManifestInterface>(class<T> $manifestClass): ?T
        => $this->manifestRegistry->query($this->alias)
            ->instancesOf($manifestClass)
            ->instanceName(ManifestNameResolver::manifestNameFromClass($manifestClass))
            ->getFirstResult();

    static configureMeta(MetadataAwareInterface $metadataAware, APIResourceInterface $apiObject): ObjectMeta {
        $meta = $apiObject->metadata();
        $metaConfigurator = new MetadataConfigurator($meta->labels(), $meta->annotations());
        $metadataAware->metadata($metaConfigurator);

        if ($metadataAware instanceof ManifestInterface) {
            $meta->setName($metadataAware->computedFullName);
        }

        return $meta;
    }
}
