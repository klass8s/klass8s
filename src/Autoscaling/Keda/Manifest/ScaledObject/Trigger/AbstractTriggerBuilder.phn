namespace Klass8s\Autoscaling\Keda\Manifest\ScaledObject\Trigger;

use Klass8s\Autoscaling\Keda\API\ScaledObject\Trigger;
use Klass8s\Core\Autoscaling\Metric\TargetType;
use Klass8s\Util\StringUtil;

abstract class AbstractTriggerBuilder implements TriggerBuilderInterface
{
    protected Trigger $trigger;

    /** The metadata keys the trigger cannot do without; a OneOf stands for keys of which exactly one is set. */
    abstract protected requiredKeys(): list<string|OneOf>;
    abstract protected static type(): string;

    __construct() {
        $this->trigger = new Trigger(static::type());
    }

    build(): Trigger {
        foreach ($this->requiredKeys() as $requiredKey) {
            if ($requiredKey instanceof OneOf) {
                $this->ensureOneOfTheKeysIsSet($requiredKey->metadataKeys);

                continue;
            }

            $this->ensureMetadataKeyIsSet($requiredKey);
        }

        return $this->trigger;
    }

    metricType(TargetType $type): static {
        $this->trigger->metricType = $type;

        return $this;
    }

    useCachedMetrics(bool $value): static {
        $this->trigger->useCachedMetrics = $value;

        return $this;
    }

    /** KEDA reads every metadata value as a string: a scalar or a \Stringable is written as one. */
    protected set(string $key, mixed $value): static {
        $this->trigger->metadata->add($key, StringUtil::stringify($value));

        return $this;
    }

    protected ensureOneOfTheKeysIsSet(list<string> $keys): static {
        $meta = $this->trigger->metadata;
        $set = [];
        foreach ($keys as $key) {
            if ($meta->has($key)) {
                $set[] = $key;
            }
        }

        if (0 === count($set)) {
            throw new \LogicException(
                sprintf(
                    'You must provide one of keys ("%s"), but none provided',
                    implode('", "', $keys),
                ),
            );
        } elseif (1 < count($set)) {
            throw new \LogicException(
                sprintf(
                    'You must provide only one of keys ("%s"), but "%s" provided',
                    implode('", "', $keys),
                    implode('", "', $set),
                ),
            );
        }

        return $this;
    }

    protected ensureMetadataKeyIsSet(string $key): static {
        if (!$this->trigger->metadata->has($key)) {
            throw new \LogicException(sprintf('You must provide "%s"', $key));
        }

        return $this;
    }
}
