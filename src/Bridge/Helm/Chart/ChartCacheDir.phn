namespace Klass8s\Bridge\Helm\Chart;

/**
 * Where pulled Helm charts live between renders.
 *
 * A chart at a pinned version is immutable, so its unpacked copy is worth keeping
 * across every render on the machine — not inside one app's kernel cache, which is
 * a fresh directory per checkout and per environment, so a machine that renders
 * several projects or environments would pull every chart again for each of them.
 * The resolution order is the configured directory, then
 * `KLASS8S_CHART_CACHE_DIR`, then `$XDG_CACHE_HOME/klass8s/charts`, then
 * `~/.cache/klass8s/charts` when the home directory can hold it, and only then the
 * kernel cache directory, for a process with no writable home.
 */
final readonly class ChartCacheDir
{
    const string ENV = 'KLASS8S_CHART_CACHE_DIR';
    const string SUBDIR = 'klass8s/charts';

    /**
     * @param $configured - the bundle's `helm.chart_cache_dir`
     * @param $kernelCacheDir - the last resort
     * @param $env - the process environment (a test seam)
     */
    static resolve(?string $configured, string $kernelCacheDir, ?map<string, string> $env = null): string {
        $env ??= array_filter(getenv(), 'is_string');
        if (null !== $configured && '' !== $configured) {
            return rtrim($configured, '/');
        }
        $fromEnv = $env[self::ENV] ?? '';
        if ('' !== $fromEnv) {
            return rtrim($fromEnv, '/');
        }
        $xdg = $env['XDG_CACHE_HOME'] ?? '';
        if ('' !== $xdg && self::usable($xdg)) {
            return rtrim($xdg, '/') . '/' . self::SUBDIR;
        }
        $home = $env['HOME'] ?? '';
        if ('' !== $home && self::usable($home)) {
            return rtrim($home, '/') . '/.cache/' . self::SUBDIR;
        }

        return rtrim($kernelCacheDir, '/') . '/helm';
    }

    /** An existing directory the process may write into. */
    private static usable(string $dir): bool => is_dir($dir) && is_writable($dir);
}
