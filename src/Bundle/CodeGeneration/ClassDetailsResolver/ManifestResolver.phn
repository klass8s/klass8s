namespace Klass8s\Bundle\CodeGeneration\ClassDetailsResolver;

use Klass8s\Bundle\CodeGeneration\ClassDetails;
use Klass8s\App\AppInterface;
use Klass8s\Util\StringUtil;

readonly class ManifestResolver
{
    /**
     * @param $useDedicatedDir - Whether to create a dir for this manifest (like dir "Example" for "ExampleDeployment")
     */
    getClassDetails(AppInterface $app, string $manifestName, string $suffix, bool $useDedicatedDir = false): ClassDetails {
        $className = StringUtil::withSuffix(StringUtil::asClassName($manifestName), $suffix);
        $namespace = StringUtil::asNamespace($app) . '\\Manifest';
        $dir = StringUtil::asDir($app) . DIRECTORY_SEPARATOR . 'Manifest';
        $fileName = $className . '.php';

        if ($useDedicatedDir) {
            $dirName = StringUtil::asDirName($manifestName, $suffix);
            $namespace .= '\\' . $dirName;
            $dir .= DIRECTORY_SEPARATOR . $dirName;
        }

        return new ClassDetails($className, $namespace, $dir, $fileName);
    }
}
