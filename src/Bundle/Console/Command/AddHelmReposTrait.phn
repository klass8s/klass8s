namespace Klass8s\Bundle\Console\Command;

use Klass8s\Bridge\Helm\Cli\HelmCli;
use Symfony\Contracts\Service\Attribute\Required;

trait AddHelmReposTrait
{
    private HelmCli $helmCli;
    /** The Helm repositories klass8s.yaml names, their URLs by name. */
    private map<string, string> $helmRepos = [];

    #[Required]
    setHelmCli(HelmCli $helmCli): void => $this->helmCli = $helmCli;

    #[Required]
    setHelmRepos(map<string, string> $helmRepos): void => $this->helmRepos = $helmRepos;

    protected addHelmRepos(): void {
        if ([] === $this->helmRepos) {
            return;
        }

        $existing = $this->helmCli->repoList();

        foreach ($this->helmRepos as $name => $url) {
            if (isset($existing[$name]) && $existing[$name] === rtrim($url, '/')) {
                continue;
            }

            $this->helmCli->repoAdd((string) $name, $url);
        }
    }
}
