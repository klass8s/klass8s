namespace Klass8s\Bundle\Console\Command;

use Klass8s\App\AppManager;
use Klass8s\Bundle\Console\UI\ModernStyle;
use Klass8s\Registry\AppRegistry;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Input\InputArgument;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Output\OutputInterface;

#[AsCommand(
    name: 'k8s:dump:apps',
    description: 'Processes apps and dumps Yaml manifests to the output dir',
)]
class DumpAppsCommand extends AbstractDumpCommand
{
    const string ARGUMENT_APPS_ALIASES = 'apps-aliases';

    __construct(
        string $manifestsDir,
        string $currentEnv,
        private readonly AppManager $appManager,
        private readonly AppRegistry $registry,
    ) {
        parent::__construct($manifestsDir, $currentEnv);
    }

    #[\Override]
    configure(): void {
        $this
            ->addArgument(
                name: self::ARGUMENT_APPS_ALIASES,
                mode: InputArgument::IS_ARRAY,
                description: 'A space separated list of app aliases. If not specified, all apps will be dumped.',
                default: [],
            )
        ;

        parent::configure();
    }

    protected execute(InputInterface $input, OutputInterface $output): int {
        $io = new ModernStyle($input, $output);
        $outputDirPath = $this->getValidOutputDir($input, (bool) $input->getOption(self::OPTION_RECREATE_DIR));
        /** @var list<string> $aliases An array argument holds the strings given on the command line. */
        $aliases = $input->getArgument(self::ARGUMENT_APPS_ALIASES);
        if ([] === $aliases) {
            $aliases = $this->registry->aliases();
        }

        $outputDir = $this->appManager->generateManifests(...$aliases);
        $outputDir->dumpTo($outputDirPath);

        $this->notifyManifestsDumped();

        if ($outputDir->isEmpty()) {
            $io->warning('No manifests were generated.');
        } else {
            $io->success(sprintf('Manifests are dumped to "<comment>%s</comment>".', $outputDirPath));
        }

        return self::SUCCESS;
    }
}
