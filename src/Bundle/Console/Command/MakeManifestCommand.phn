namespace Klass8s\Bundle\Console\Command;

use Klass8s\App\AppInterface;
use Klass8s\Bundle\CodeGeneration\ManifestGenerator\Context\ContextInterface;
use Klass8s\Bundle\CodeGeneration\ManifestGenerator\ContextRegistry;
use Klass8s\Bundle\CodeGeneration\ManifestGenerator\ManifestClassGenerator;
use Klass8s\Bundle\Console\UI\ModernStyle;
use Klass8s\Registry\AppRegistry;
use Klass8s\Registry\ManifestRegistry;
use Klass8s\Util\StringUtil;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputArgument;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Question\ChoiceQuestion;
use Symfony\Component\Console\Style\SymfonyStyle;

#[AsCommand(
    name: 'k8s:make:manifest',
    description: 'Creates a new manifest class in specified app.',
)]
class MakeManifestCommand extends Command
{
    private const string ARGUMENT_MANIFEST_KIND = 'manifest-type';
    private const string ARGUMENT_MANIFEST_NAME = 'manifest-name';
    private const string OPTION_APP = 'app';

    __construct(
        private readonly AppRegistry $appRegistry,
        private readonly ManifestRegistry $manifestRegistry,
        private readonly ContextRegistry $contextRegistry,
        private readonly ManifestClassGenerator $generator,
    ) {
        parent::__construct();
    }

    configure(): void => $this
        ->addArgument(
            self::ARGUMENT_MANIFEST_NAME,
            InputArgument::REQUIRED,
            'Manifest short name without type suffix (e.g. <fg=yellow>users-sync</>)',
        )
        ->addArgument(
            self::ARGUMENT_MANIFEST_KIND,
            InputArgument::OPTIONAL,
            'Manifest type (e.g. <fg=yellow>deployment</> or <fg=yellow>config-map</>)',
        )
        ->addOption(
            self::OPTION_APP,
            mode: InputOption::VALUE_REQUIRED,
            description: 'App alias (e.g. <fg=yellow>users</>)',
        );

    execute(InputInterface $input, OutputInterface $output): int {
        $io = new ModernStyle($input, $output);

        try {
            $context = $this->getContext($input, $io);
            $appAlias = $this->getAppAlias($input, $io);
            $app = $this->appRegistry->get($appAlias);
            $name = $this->getManifestName($input, $context, $appAlias);
        } catch (\InvalidArgumentException $e) {
            $io->error($e->getMessage());
            $io->newLine();

            return self::FAILURE;
        }

        try {
            $fileName = $this->generator->generate($name, $context, $app);
        } catch (\Throwable $e) {
            $io->error($e->getMessage());
            $io->newLine();

            return self::FAILURE;
        }

        $io->success(
            sprintf(
                '%s "%s" successfully generated, see file "%s"',
                $context->kind(),
                $name,
                $fileName,
            ),
        );

        return self::SUCCESS;
    }

    private getAppAlias(InputInterface $input, SymfonyStyle $io): string {
        $appAlias = $input->getOption(self::OPTION_APP);
        if (is_string($appAlias) && '' !== $appAlias) {
            return $appAlias;
        }

        $question = new ChoiceQuestion(
            'Please choose an app, for which you want to generate new manifest class',
            array_values($this->appRegistry->classes()),
        );
        /** @var class<AppInterface> $appClass One of the choices. */
        $appClass = $io->askQuestion($question);

        foreach ($this->appRegistry->allAppsByClass($appClass) as $alias => $app) {
            return $alias;
        }

        throw new \InvalidArgumentException(sprintf('App for class name "%s" does not exist', $appClass));
    }

    private getContext(InputInterface $input, SymfonyStyle $io): ContextInterface {
        $supportedTypes = array_map(StringUtil::asDNSSubdomain(...), $this->contextRegistry->kinds());

        $typeName = $input->getArgument(self::ARGUMENT_MANIFEST_KIND)
            ?? $io->askQuestion(new ChoiceQuestion('Choose a manifest kind', $supportedTypes));
        assert(is_string($typeName));

        $kind = StringUtil::asClassName($typeName);
        if (!$this->contextRegistry->has($kind)) {
            throw new \InvalidArgumentException(sprintf('Manifest kind "%s" is not supported. Supported types: "%s".', $typeName, implode('", "', $supportedTypes)));
        }

        return $this->contextRegistry->get($kind);
    }

    private getManifestName(InputInterface $input, ContextInterface $context, string $appAlias): string {
        $name = $input->getArgument(self::ARGUMENT_MANIFEST_NAME);
        if (!is_string($name) || !StringUtil::isValidDNSSubdomain($name)) {
            $errTemplate = <<<'ERR'
                Name "%s" is not valid for manifest name. It must be valid DNS subdomain name, i.e. it must:
                - contain no more than 253 characters
                - contain only lowercase alphanumeric characters, '-' or '.'
                - start with an alphanumeric character
                - end with an alphanumeric character
                ERR;

            throw new \InvalidArgumentException(sprintf($errTemplate, $name));
        }

        $manifest = $this->manifestRegistry->query($appAlias)
            ->instancesOf($context->parentInterface())
            ->instanceName($name)
            ->getFirstResult();

        if (null !== $manifest) {
            throw new \InvalidArgumentException(sprintf('Name "%s" is already taken by "%s"', $name, $manifest::class));
        }

        return $name;
    }
}
