namespace Klass8s\Bundle\DependencyInjection\Compiler;

use Klass8s\Bundle\EventListener\StripNamespaceSubscriber;
use Symfony\Component\DependencyInjection\Compiler\CompilerPassInterface;
use Symfony\Component\DependencyInjection\ContainerBuilder;

final readonly class DisableStripNamespacePass implements CompilerPassInterface
{
    process(ContainerBuilder $container): void {
        if ($container->hasParameter('klass8s.strip_namespace') && false === $container->getParameter('klass8s.strip_namespace')) {
            $container->removeDefinition(StripNamespaceSubscriber::class);
        }
    }
}
