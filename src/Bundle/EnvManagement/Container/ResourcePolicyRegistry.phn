namespace Klass8s\Bundle\EnvManagement\Container;

class ResourcePolicyRegistry
{
    /** where key is an environment name, like "dev", "prod", etc. */
    private map<string, ResourcePolicy> $policies = [];

    whenEnv(string $env): ResourcePolicy {
        if (!array_key_exists($env, $this->policies)) {
            $this->policies[$env] = new ResourcePolicy();
        }

        return $this->policies[$env];
    }
}
