namespace Klass8s\Bundle\EventListener;

use Klass8s\Bundle\Attribute\NoDefaultSelectorLabels;
use Klass8s\Bundle\Util\AttributesUtil;
use Klass8s\Core\Deployment\DeploymentInterface;
use Klass8s\Core\LabelSelector\SelectorConfigurator;
use Klass8s\Core\StatefulSet\StatefulSetInterface;
use Klass8s\Event\ProxyableMethodEventInterface;
use Klass8s\Manifest\Labels\LabelsGeneratorInterface;
use Klass8s\Proxy\ProxyManager;

class DefaultSelectorLabelsSubscriber extends AbstractManifestMethodSubscriber
{
    __construct(private readonly LabelsGeneratorInterface $labelsGenerator) {}

    protected supports(ProxyableMethodEventInterface $event): bool {
        $manifest = $event->proxyable();

        return ($manifest instanceof DeploymentInterface || $manifest instanceof StatefulSetInterface)
            && 'selector' === $event->methodName();
    }

    protected beforeMethod(ProxyableMethodEventInterface $event): void {
        /** @var DeploymentInterface|StatefulSetInterface $manifest */
        $manifest = $event->proxyable();
        if (self::classHasNoSelectorAttribute(ProxyManager::unwrapClassName($manifest))) {
            return;
        }

        $event->typedMethodParam('selector', SelectorConfigurator::class)->addLabels($this->labelsGenerator->forManifest($manifest));
    }

    private static classHasNoSelectorAttribute(class<object> $className): bool
        => null !== AttributesUtil::fromClass(new \ReflectionClass($className), NoDefaultSelectorLabels::class);
}
