namespace Klass8s\Core\Container\Lifecycle\Action;

use K8Schema\Api\Core\V1\HTTPGetAction;
use K8Schema\Api\Core\V1\TCPSocketAction;

trait ActionConfiguratorTrait
{
    exec(array<string> $command): void => $this->handler->exec()->command()->addAll(array_values($command));

    httpGet(int|string $port): HttpGetActionBuilder {
        $action = new HTTPGetAction($port);
        $this->handler->setHttpGet($action);

        return new HttpGetActionBuilder($action);
    }

    tcpSocket(int|string $port, ?string $host = null): void {
        $action = new TCPSocketAction($port);
        if (null !== $host) {
            $action->setHost($host);
        }

        $this->handler->setTcpSocket($action);
    }
}
