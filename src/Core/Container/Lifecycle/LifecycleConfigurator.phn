namespace Klass8s\Core\Container\Lifecycle;

use K8Schema\Api\Core\V1\Lifecycle;
use Klass8s\Core\Container\Lifecycle\Action\LifecycleActionConfigurator;

class LifecycleConfigurator
{
    __construct(private Lifecycle $lifecycle) {}

    preStop(): LifecycleActionConfigurator => new LifecycleActionConfigurator($this->lifecycle->preStop());

    postStart(): LifecycleActionConfigurator => new LifecycleActionConfigurator($this->lifecycle->postStart());
}
