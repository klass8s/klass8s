namespace Klass8s\Core\Container\Resources;

use LogicException;

final readonly class Memory implements \JsonSerializable
{
    private const string SUFFIX_KIBIBYTES = 'Ki';
    private const string SUFFIX_MEBIBYTES = 'Mi';
    private const string SUFFIX_GIBIBYTES = 'Gi';
    private const string SUFFIX_TEBIBYTES = 'Ti';
    private const string SUFFIX_PEBIBYTES = 'Pi';
    private const string SUFFIX_EXBIBYTES = 'Ei';
    private const list<string> VALID_SUFFIXES = [
        self::SUFFIX_KIBIBYTES,
        self::SUFFIX_MEBIBYTES,
        self::SUFFIX_GIBIBYTES,
        self::SUFFIX_TEBIBYTES,
        self::SUFFIX_PEBIBYTES,
        self::SUFFIX_EXBIBYTES,
    ];

    private const map<string, int> SUFFIX_MULTIPLIERS = [
        self::SUFFIX_KIBIBYTES => 1024,
        self::SUFFIX_MEBIBYTES => 1024 * 1024,
        self::SUFFIX_GIBIBYTES => 1024 * 1024 * 1024,
        self::SUFFIX_TEBIBYTES => 1024 * 1024 * 1024 * 1024,
        self::SUFFIX_PEBIBYTES => 1024 * 1024 * 1024 * 1024 * 1024,
        self::SUFFIX_EXBIBYTES => 1024 * 1024 * 1024 * 1024 * 1024 * 1024,
    ];

    private __construct(private string $value) {}

    toString(): string => $this->value;

    add(Memory $memory): Memory {
        $totalBytes = $this->bytesNumber() + $memory->bytesNumber();

        return new self(self::format($totalBytes));
    }

    static bytes(int $bytes): self => new self(strval($bytes));

    static kibibytes(int $kibibytes): self {
        $value = strval($kibibytes) . self::SUFFIX_KIBIBYTES;

        return new self($value);
    }

    static mebibytes(int $mebibytes): self {
        $value = strval($mebibytes) . self::SUFFIX_MEBIBYTES;

        return new self($value);
    }

    static gibibytes(int $gibibytes): self {
        $value = strval($gibibytes) . self::SUFFIX_GIBIBYTES;

        return new self($value);
    }

    static tebibytes(int $gibibytes): self {
        $value = strval($gibibytes) . self::SUFFIX_TEBIBYTES;

        return new self($value);
    }

    static pebibytes(int $gibibytes): self {
        $value = strval($gibibytes) . self::SUFFIX_PEBIBYTES;

        return new self($value);
    }

    static exbibytes(int $gibibytes): self {
        $value = strval($gibibytes) . self::SUFFIX_EXBIBYTES;

        return new self($value);
    }

    greaterThan(Memory $memory): bool => $this->bytesNumber() > $memory->bytesNumber();

    lowerThan(Memory $memory): bool => $this->bytesNumber() < $memory->bytesNumber();

    equals(Memory $memory): bool => $this->bytesNumber() === $memory->bytesNumber();

    bytesNumber(): int {
        if (is_numeric($this->value)) {
            return (int) $this->value;
        }

        $pattern = '/(\d+)([a-z]+)/ui';
        preg_match($pattern, $this->value, $matches);
        $number = (int) $matches[1];
        $suffix = $matches[2] ?? null;
        if (!$suffix || !array_key_exists($suffix, self::SUFFIX_MULTIPLIERS)) {
            throw new LogicException(sprintf('Invalid Memory value format: "%s"', $this->value));
        }

        return $number * self::SUFFIX_MULTIPLIERS[$suffix];
    }

    prettify(): self => new self(self::format($this->bytesNumber()));

    /**
     * A whole number of bytes, alone or with one of the binary suffixes: "134217728", "128Mi".
     * Nothing else is read, not a sign, a space, a fraction or a decimal unit, and the bytes it
     * stands for have to fit in an int.
     */
    static fromString(string $string): self {
        if (1 !== preg_match(sprintf('/^(\d+)(%s)?$/D', implode('|', self::VALID_SUFFIXES)), $string, $matches)) {
            throw new \InvalidArgumentException(sprintf(
                'Invalid Memory string "%s": expected a whole number of bytes, optionally followed by one of %s.',
                $string,
                implode(', ', self::VALID_SUFFIXES),
            ));
        }

        $suffix = $matches[2] ?? '';
        $multiplier = '' === $suffix ? 1 : self::SUFFIX_MULTIPLIERS[$suffix];
        $number = filter_var(ltrim($matches[1], '0') ?: '0', FILTER_VALIDATE_INT);
        if (false === $number || $number > intdiv(PHP_INT_MAX, $multiplier)) {
            throw new \InvalidArgumentException(sprintf('Memory string "%s" is more bytes than PHP can count, which is %d.', $string, PHP_INT_MAX));
        }

        return '' === $suffix ? self::bytes($number) : new self($string);
    }

    protected static format(int $bytesNumber): string {
        if ($bytesNumber <= 0) {
            throw new \InvalidArgumentException('$bytesNumber must be greater than 0');
        }

        // From bigger multipliers to lesser
        $multipliers = array_reverse(self::SUFFIX_MULTIPLIERS);
        foreach ($multipliers as $suffix => $multiplier) {
            if (0 === $bytesNumber % $multiplier) {
                return strval($bytesNumber / $multiplier) . $suffix;
            }
        }

        return strval($bytesNumber);
    }

    jsonSerialize(): string => $this->toString();
}
