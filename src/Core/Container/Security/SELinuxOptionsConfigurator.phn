namespace Klass8s\Core\Container\Security;

use K8Schema\Api\Core\V1\SELinuxOptions;

class SELinuxOptionsConfigurator
{
    __construct(private SELinuxOptions $options) {}

    /** Level is SELinux level label that applies to the container. */
    setLevel(string $level): static {
        $this->options->setLevel($level);

        return $this;
    }

    /** Role is a SELinux role label that applies to the container. */
    setRole(string $role): static {
        $this->options->setRole($role);

        return $this;
    }

    /** Type is a SELinux type label that applies to the container. */
    setType(string $type): static {
        $this->options->setType($type);

        return $this;
    }

    /** User is a SELinux user label that applies to the container. */
    setUser(string $user): static {
        $this->options->setUser($user);

        return $this;
    }
}
