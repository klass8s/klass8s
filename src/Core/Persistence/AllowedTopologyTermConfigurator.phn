namespace Klass8s\Core\Persistence;

use K8Schema\Api\Core\V1\TopologySelectorLabelRequirement;
use K8Schema\Api\Core\V1\TopologySelectorTerm;

/**
 * One term of a StorageClass' `allowedTopologies`: every label requirement
 * added here must hold on a node for the term to match (terms themselves are OR-ed).
 */
readonly class AllowedTopologyTermConfigurator
{
    __construct(private TopologySelectorTerm $term) {}

    matchLabel(string $key, string ...$values): static {
        if (0 === count($values)) {
            throw new \InvalidArgumentException(sprintf('You must provide at least one value for topology label "%s".', $key));
        }

        $requirement = new TopologySelectorLabelRequirement($key);
        $requirement->values()->addAll($values);
        $this->term->matchLabelExpressions()->add($requirement);

        return $this;
    }
}
