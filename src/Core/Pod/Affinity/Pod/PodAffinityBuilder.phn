namespace Klass8s\Core\Pod\Affinity\Pod;

use K8Schema\Api\Core\V1\PodAffinityTerm;
use K8Schema\Api\Core\V1\PodAffinityTermList;
use K8Schema\Api\Core\V1\WeightedPodAffinityTerm;
use K8Schema\Api\Core\V1\WeightedPodAffinityTermList;
use Klass8s\Core\Pod\Affinity\PodAffinityExpression;

class PodAffinityBuilder
{
    __construct(
        private WeightedPodAffinityTermList $preferences,
        private PodAffinityTermList $requirements,
    ) {}

    addPreferenceByExpression(PodAffinityExpression $expression, int $weight, string $topologyKey, ?list<string> $namespaces = null): static {
        $term = $this->affinityTermFromExpression($expression, $topologyKey, $namespaces);
        $weightedTerm = new WeightedPodAffinityTerm($term, $weight);
        $this->preferences->add($weightedTerm);

        return $this;
    }

    addPreferenceByLabels(map<string, string> $labels, int $weight, string $topologyKey, ?list<string> $namespaces = null): static {
        $term = $this->affinityTermByLabel($labels, $topologyKey, $namespaces);
        $weightedTerm = new WeightedPodAffinityTerm($term, $weight);
        $this->preferences->add($weightedTerm);

        return $this;
    }

    addRequirementByExpression(PodAffinityExpression $expression, string $topologyKey, ?list<string> $namespaces = null): static {
        $term = $this->affinityTermFromExpression($expression, $topologyKey, $namespaces);
        $this->requirements->add($term);

        return $this;
    }

    addRequirementByLabels(map<string, string> $labels, string $topologyKey, ?list<string> $namespaces = null): static {
        $term = $this->affinityTermByLabel($labels, $topologyKey, $namespaces);
        $this->requirements->add($term);

        return $this;
    }

    private affinityTermFromExpression(PodAffinityExpression $expression, string $topologyKey, ?list<string> $namespaces = null): PodAffinityTerm {
        $selector = $expression->toLabelSelectorRequirement();
        $term = new PodAffinityTerm($topologyKey);
        $term->labelSelector()->matchExpressions()->add($selector);
        if (null !== $namespaces) {
            $term->namespaces()->addAll($namespaces);
        }

        return $term;
    }

    private affinityTermByLabel(map<string, string> $labels, string $topologyKey, ?list<string> $namespaces = null): PodAffinityTerm {
        $term = new PodAffinityTerm($topologyKey);
        $matchLabels = $term->labelSelector()->matchLabels();
        foreach ($labels as $labelKey => $labelValue) {
            $matchLabels->add($labelKey, $labelValue);
        }
        if (null !== $namespaces) {
            $term->namespaces()->addAll($namespaces);
        }

        return $term;
    }
}
