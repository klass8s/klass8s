namespace Klass8s\Core\Pod\Topology;

use K8Schema\Api\Core\V1\TopologySpreadConstraint;
use K8Schema\Api\Core\V1\TopologySpreadConstraintList;

readonly class TopologySpreadConstraintsConfigurator
{
    __construct(private TopologySpreadConstraintList $constraints) {}

    add(int $maxSkew, string $topologyKey, WhenUnsatisfiable $whenUnsatisfiable): TopologySpreadConstraintConfigurator {
        $constraint = new TopologySpreadConstraint($maxSkew, $topologyKey, $whenUnsatisfiable->value);
        $this->constraints->add($constraint);

        return new TopologySpreadConstraintConfigurator($constraint);
    }
}
