namespace Klass8s\Core\Pod\Volume;

use K8Schema\Api\Core\V1\Volume;
use K8Schema\Api\Core\V1\VolumeList;
use Klass8s\App\AppInterface;
use Klass8s\Core\ConfigMap\ConfigMapInterface;
use Klass8s\Core\Container\Env\ExternalConfigurationRegistry;
use Klass8s\Core\Persistence\PersistentVolumeClaimInterface;
use Klass8s\Core\Pod\Volume\Builder\ConfigMapVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\DownwardAPIVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\EmptyDirVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\HostPathVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\PVCVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\SecretVolumeBuilder;
use Klass8s\Core\Pod\Volume\Builder\VolumeBuilderInterface;
use Klass8s\Core\Secret\SecretInterface;
use Klass8s\Registry\AppRegistry;

readonly class VolumesConfigurator
{
    __construct(
        private VolumeList $volumes,
        private AppInterface $app,
        private AppRegistry $registry,
        private ExternalConfigurationRegistry $externalConfigurations,
    ) {}

    fromConfigMapClass(string $volumeName, class<ConfigMapInterface> $configMapClass): ConfigMapVolumeBuilder {
        $cmName = $this->app->resourceNameFromManifestClass($configMapClass, ConfigMapInterface::class);

        return $this->fromConfigMap($volumeName, $cmName);
    }

    /**
     * @param $external - The ConfigMap is not rendered by this project — it is created by an
     *                       operator, another chart or a cluster administrator. Klass8s then knows
     *                       the name but never the content: the render stops validating that a
     *                       manifest of that name exists, and the volume-sources checksum leaves
     *                       it out (it cannot fingerprint bytes it does not produce).
     */
    fromConfigMap(string $volumeName, string $configMapName, bool $external = false): ConfigMapVolumeBuilder {
        if ($external) {
            $this->externalConfigurations->addConfigMap($configMapName);
        }

        return $this->initBuilder(new ConfigMapVolumeBuilder($configMapName), $volumeName);
    }

    fromEmptyDir(string $volumeName): EmptyDirVolumeBuilder {
        $builder = new EmptyDirVolumeBuilder();

        return $this->initBuilder($builder, $volumeName);
    }

    fromDownwardAPI(string $volumeName): DownwardAPIVolumeBuilder {
        $builder = new DownwardAPIVolumeBuilder();

        return $this->initBuilder($builder, $volumeName);
    }

    fromPvcClass(string $volumeName, class<PersistentVolumeClaimInterface> $pvcClass): PVCVolumeBuilder {
        $pvcName = $this->app->resourceNameFromManifestClass($pvcClass, PersistentVolumeClaimInterface::class);

        return $this->fromPvc($volumeName, $pvcName);
    }

    /** @param $pvcName - PVC name, not a manifest class name */
    fromPvc(string $volumeName, string $pvcName): PVCVolumeBuilder {
        $builder = new PVCVolumeBuilder($pvcName);

        return $this->initBuilder($builder, $volumeName);
    }

    fromSecretClass(string $volumeName, class<SecretInterface> $secretClass): SecretVolumeBuilder {
        $secretName = $this->app->resourceNameFromManifestClass($secretClass, SecretInterface::class);

        return $this->fromSecret($volumeName, $secretName);
    }

    /**
     * @param $external - The Secret is not rendered by this project — the canonical case is a
     *                       Secret materialised by the External Secrets Operator from an
     *                       `ExternalSecret` pointer. Klass8s knows the name and never the content,
     *                       so the volume-sources checksum leaves it out: a rotation in the secret
     *                       store changes no manifest and rolls no pod (that is ESO's job, not the
     *                       renderer's).
     */
    fromSecret(string $volumeName, string $secretName, bool $external = false): SecretVolumeBuilder {
        if ($external) {
            $this->externalConfigurations->addSecret($secretName);
        }

        return $this->initBuilder(new SecretVolumeBuilder($secretName), $volumeName);
    }

    fromHostPath(string $volumeName, string $path): HostPathVolumeBuilder {
        $builder = new HostPathVolumeBuilder($path);
        $this->initBuilder($builder, $volumeName);

        return $builder;
    }

    withExternalApp(string $appAlias): static
        => new static($this->volumes, $this->registry->get($appAlias), $this->registry, $this->externalConfigurations);

    private createVolume(string $name): Volume {
        $volume = new Volume($name);
        $this->volumes->add($volume);

        return $volume;
    }

    private initBuilder<T of VolumeBuilderInterface>(T $builder, string $volumeName): T {
        $volume = $this->createVolume($volumeName);
        $builder->init($volume);

        return $builder;
    }
}
