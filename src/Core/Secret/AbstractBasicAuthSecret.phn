namespace Klass8s\Core\Secret;

use K8Schema\Collection\StringMap;

abstract class AbstractBasicAuthSecret extends AbstractSecret
{
    abstract protected username(): string;
    abstract protected password(): string;

    final data(StringMap $data): void => $data->addAll([
        'username' => $this->username(),
        'password' => $this->password(),
    ]);

    final stringData(StringMap $stringData): void {}

    final type(): SecretType => SecretType::BasicAuth;
}
