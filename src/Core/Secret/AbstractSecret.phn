namespace Klass8s\Core\Secret;

use K8Schema\Api\Core\V1\Secret;
use K8Schema\Collection\StringMap;
use Klass8s\Manifest\AbstractManifest;

abstract class AbstractSecret extends AbstractManifest implements SecretInterface
{
    data(StringMap $data): void {}

    stringData(StringMap $stringData): void {}

    keysPrefix(): string => '';

    type(): SecretType => SecretType::Opaque;

    configureSecret(Secret $secret): void {}

    final static kind(): string => Secret::KIND;

    final static apiVersion(): string => Secret::API_VERSION;
}
