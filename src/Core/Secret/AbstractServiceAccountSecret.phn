namespace Klass8s\Core\Secret;

use K8Schema\Collection\StringMap;
use Klass8s\Manifest\MetadataConfigurator;

abstract class AbstractServiceAccountSecret extends AbstractSecret
{
    private const string ANNOTATION_KEY = 'kubernetes.io/service-account.name';

    abstract protected serviceAccountName(): string;

    final data(StringMap $data): void => $this->extraData($data);

    final stringData(StringMap $stringData): void {}

    metadata(MetadataConfigurator $meta): void
        => $meta->annotations()->add(self::ANNOTATION_KEY, $this->serviceAccountName());

    final type(): SecretType => SecretType::ServiceAccountToken;

    protected extraData(StringMap $data): void {}
}
