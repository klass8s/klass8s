namespace Klass8s\Core\Secret;

use K8Schema\Api\Core\V1\Secret;
use K8Schema\Collection\StringMap;
use Klass8s\Manifest\ManifestInterface;

interface SecretInterface extends ManifestInterface
{
    data(StringMap $data): void;
    stringData(StringMap $stringData): void;
    keysPrefix(): string;
    type(): SecretType;
    configureSecret(Secret $secret): void;
}
