namespace Klass8s\GatewayApi;

use K8Schema\Apimachinery\Pkg\Apis\Meta\V1\ObjectMeta;
use K8Schema\APIResourceInterface;

abstract class AbstractGatewayApiResource implements APIResourceInterface
{
    const string API_VERSION = 'gateway.networking.k8s.io/v1';

    /** @param $data - The resource as data, its ObjectMeta under `metadata` */
    __construct(protected \ArrayObject<string, mixed> $data) {}

    metadata(): ObjectMeta {
        $metadata = $this->data['metadata'];
        assert($metadata instanceof ObjectMeta);

        return $metadata;
    }

    jsonSerialize(): \ArrayObject<string, mixed> => $this->data;
}
