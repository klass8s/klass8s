use Klass8s\Manifest\ManifestInterface;

interface BackendTLSPolicyInterface extends ManifestInterface
{
    targetRefs(TargetRefsConfigurator $targetRefs): void;

    validation(TLSValidationConfigurator $validation): void;

    options(OptionsConfigurator $options): void;
}
