namespace Klass8s\GatewayApi\BackendTLSPolicy\Configurator;

use Klass8s\App\AppInterface;
use Klass8s\Collection\NestedData;
use Klass8s\Core\ConfigMap\ConfigMapInterface;
use Klass8s\Core\Secret\SecretInterface;

final class TLSValidationConfigurator
{
    __construct(
        private \ArrayObject<string, mixed> $data,
        private AppInterface $app,
    ) {}

    hostname(string $hostname): static {
        $this->data['hostname'] = $hostname;

        return $this;
    }

    caCertificateFromConfigMap(string $name, string $group = '', string $kind = 'ConfigMap'): static {
        NestedData::append($this->data, 'caCertificateRefs', [
            'group' => $group,
            'kind' => $kind,
            'name' => $name,
        ]);

        return $this;
    }

    caCertificateFromConfigMapClass(class<ConfigMapInterface> $configMapClass): static {
        $name = $this->app->resourceNameFromManifestClass($configMapClass, ConfigMapInterface::class);

        return $this->caCertificateFromConfigMap($name);
    }

    caCertificateFromSecret(string $name, string $group = '', string $kind = 'Secret'): static {
        NestedData::append($this->data, 'caCertificateRefs', [
            'group' => $group,
            'kind' => $kind,
            'name' => $name,
        ]);

        return $this;
    }

    caCertificateFromSecretClass(class<SecretInterface> $secretClass): static {
        $name = $this->app->resourceNameFromManifestClass($secretClass, SecretInterface::class);

        return $this->caCertificateFromSecret($name);
    }

    wellKnownCACertificates(string $type = 'System'): static {
        $this->data['wellKnownCACertificates'] = $type;

        return $this;
    }

    subjectAltNameHostname(string $hostname): static {
        NestedData::append($this->data, 'subjectAltNames', [
            'type' => 'Hostname',
            'hostname' => $hostname,
        ]);

        return $this;
    }

    subjectAltNameURI(string $uri): static {
        NestedData::append($this->data, 'subjectAltNames', [
            'type' => 'URI',
            'uri' => $uri,
        ]);

        return $this;
    }
}
