namespace Klass8s\GatewayApi\ReferenceGrant\Configurator;

use Klass8s\Collection\GenericList;

final readonly class ReferenceGrantToConfigurator
{
    __construct(private GenericList<map<string, string>> $data) {}

    add(string $group, string $kind, ?string $name = null): static {
        $entry = [
            'group' => $group,
            'kind' => $kind,
        ];

        if (null !== $name) {
            $entry['name'] = $name;
        }

        $this->data->add($entry);

        return $this;
    }

    allowServices(?string $name = null): static => $this->add('', 'Service', $name);

    allowSecrets(?string $name = null): static => $this->add('', 'Secret', $name);

    allowConfigMaps(?string $name = null): static => $this->add('', 'ConfigMap', $name);
}
