namespace Klass8s\Manifest;

use Klass8s\Config\ConfigAwareInterface;
use Klass8s\Proxy\ProxyableInterface;

interface ManifestInterface extends AppAwareInterface, ConfigAwareInterface, MetadataAwareInterface, ProxyableInterface
{
    /**
     * The short name of the manifest instance.
     * Covers both the static short name and dynamic name in the case of `ManifestTemplateInterface`
     * @see shortName()
     * @see ManifestTemplateInterface::$dynamicShortName
     */
    public string $computedShortName { get; }

    /** The full name of the Kubernetes resource that will be generated from this manifest. */
    public string $computedFullName { get; }

    /** The file name (without extension like `.yaml`) generated manifest will be saved to. */
    public string $fileName { get; }

    static apiVersion(): string;
    static kind(): string;

    /**
     * The name of the manifest, without the namespace / app prefix: for a manifest with the
     * resource name `shop-api` it is `api`.
     */
    static shortName(): string;

    /** The fully qualified class name of the manifest, unwrapped from a proxy class. */
    static className(): string;
}
