namespace Klass8s\Monitoring\Prometheus\Configurator;

use K8Schema\Collection\StringMap;

final class GroupRuleConfigurator
{
    __construct(private \ArrayObject<string, mixed> $data) {}

    alert(string $alert): static {
        $this->data['alert'] = $alert;

        return $this;
    }

    annotations(): StringMap {
        $this->data['annotations'] = new StringMap();

        return $this->data['annotations'];
    }

    for(string $for): static {
        $this->data['for'] = $for;

        return $this;
    }

    labels(): StringMap {
        $this->data['labels'] = new StringMap();

        return $this->data['labels'];
    }

    record(string $record): static {
        $this->data['record'] = $record;

        return $this;
    }
}
