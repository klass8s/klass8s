namespace Klass8s\Monitoring\Prometheus\Configurator;

final readonly class SecretKeyReference implements \JsonSerializable
{
    private __construct(
        private string $name,
        private string $key,
        private bool $optional,
    ) {}

    static fromSecretNameAndKey(string $secretName, string $secretKey, bool $optional): self
        => new self($secretName, $secretKey, $optional);

    jsonSerialize(): map<string, string|bool> => [
        'name' => $this->name,
        'key' => $this->key,
        'optional' => $this->optional,
    ];
}
