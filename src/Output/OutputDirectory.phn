namespace Klass8s\Output;

use Klass8s\Renderer\RendererInterface;
use Klass8s\Renderer\YamlRenderer;
use Klass8s\Value\YamlString;

final class OutputDirectory
{
    private const string YAML_DOCUMENT_SEPARATOR = "\n---\n";

    /**
     * Files are kept unrendered (RenderableFile holds the live resource object) until
     * render()/dumpTo(), so listeners on ManifestsProcessedEvent can still mutate
     * resources (e.g. checksum annotations) or add files before anything is serialized.
     */
    private map<string, RenderableFile|RenderedFile|OutputDirectory> $files = [];

    __construct(public readonly string $name, public readonly RendererInterface $renderer) {}

    addDirectory(OutputDirectory $directory): void {
        if (array_key_exists($directory->name, $this->files)) {
            $type = $this->files[$directory->name] instanceof OutputDirectory ? 'Directory' : 'File';
            throw new \LogicException(sprintf('%s "%s" already exists in the output directory "%s" .', $type, $directory->name, $this->name));
        }

        $this->files[$directory->name] = $directory;
    }

    directory(string $name): ?self {
        $entry = $this->files[$name] ?? null;

        return $entry instanceof self ? $entry : null;
    }

    addFile(RenderableFile|RenderedFile $file): void {
        $filename = $file instanceof RenderableFile
            ? $file->nameWithoutExtension . $this->renderer->fileExtension()
            : $file->filename;

        if (array_key_exists($filename, $this->files)) {
            throw new \LogicException(sprintf('File "%s" already exists in the output directory "%s" .', $filename, $this->name));
        }

        $this->files[$filename] = $file;
    }

    dumpTo(string $directoryPath): void {
        $path = $directoryPath . '/' . $this->name;
        if (!is_dir($path)) {
            if (file_exists($path)) {
                throw new \LogicException(sprintf('Path for output directory "%s" already exists and it is a file.', $path));
            }

            mkdir($path, 0o777, true);
        }

        foreach ($this->files as $filename => $file) {
            if ($file instanceof OutputDirectory) {
                $file->dumpTo($path);
            } else {
                file_put_contents($path . '/' . $filename, $this->contentsOf($file));
            }
        }
    }

    /** Every file of the directory and its subdirectories as one YAML stream, each document headed by its path; empty when there are none. */
    render(): YamlString {
        if (!$this->renderer instanceof YamlRenderer) {
            throw new \LogicException(sprintf('"%s" supports rendering only in YAML format, but "%s" is given as a renderer.', self::class, $this->renderer::class));
        }

        return new YamlString(implode(self::YAML_DOCUMENT_SEPARATOR, $this->documents('')));
    }

    /** Whether the directory holds no file, in itself or in any of its subdirectories. */
    isEmpty(): bool => array_all($this->files, static fn(RenderableFile|RenderedFile|OutputDirectory $file): bool => $file instanceof self && $file->isEmpty());

    private documents(string $filenamePrefix): list<string> {
        $documents = [];
        foreach ($this->files as $filename => $file) {
            $fullName = $filenamePrefix . '/' . $filename;
            if ($file instanceof OutputDirectory) {
                array_push($documents, ...$file->documents($fullName));
            } else {
                $documents[] = "# File: {$fullName}\n" . $this->contentsOf($file);
            }
        }

        return $documents;
    }

    private contentsOf(RenderableFile|RenderedFile $file): string
        => $file instanceof RenderableFile ? $file->render($this->renderer) : $file->contents;
}
