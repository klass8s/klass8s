namespace Klass8s\ResourceMaker\Prometheus;

use K8Schema\Apimachinery\Pkg\Apis\Meta\V1\LabelSelector;
use K8Schema\Apimachinery\Pkg\Apis\Meta\V1\ObjectMeta;
use K8Schema\Collection\StringList;
use Klass8s\Monitoring\Prometheus\Configurator\NamespaceSelectorConfigurator;
use Klass8s\Monitoring\Prometheus\MonitorApiResource;
use Klass8s\Monitoring\Prometheus\MonitorInterface;
use Klass8s\ResourceMaker\AbstractResourceMaker;
use Klass8s\ResourceMaker\Traits\ConfigureSelectorTrait;

/**
 * Makes the Prometheus Operator's monitors, whose resources have no class
 * in k8schema: the resource is built as nested data, the spec's part common
 * to every monitor here and the rest by the subclass.
 */
abstract class AbstractMonitorMaker<M of MonitorInterface> extends AbstractResourceMaker<M, MonitorApiResource>
{
    use ConfigureSelectorTrait;

    /** Writes what is particular to this kind of monitor into the resource's spec. */
    abstract protected configureMonitor(M $manifest, \ArrayObject<string, mixed> $spec): void;

    protected makeResource(M $manifest): MonitorApiResource {
        $selector = new LabelSelector();
        $namespaceSelector = new \ArrayObject<string, mixed>();
        $spec = new \ArrayObject<string, mixed>(['selector' => $selector, 'namespaceSelector' => $namespaceSelector]);
        $data = new \ArrayObject<string, mixed>([
            'apiVersion' => $manifest::apiVersion(),
            'kind' => $manifest::kind(),
            'metadata' => new ObjectMeta(),
            'spec' => $spec,
        ]);

        $monitor = new MonitorApiResource($data);
        $app = $manifest->app;
        $app::configureMeta($manifest, $monitor);
        $this->configureSelector($manifest, $selector);

        $manifest->namespaceSelector(new NamespaceSelectorConfigurator($namespaceSelector));

        $podTargetLabels = new StringList();
        $manifest->podTargetLabels($podTargetLabels);

        if ($podTargetLabels->count() > 0) {
            $spec['podTargetLabels'] = $podTargetLabels;
        }

        if ($jobLabel = $manifest->jobLabel()) {
            $spec['jobLabel'] = $jobLabel;
        }

        if ($sampleLimit = $manifest->sampleLimit()) {
            $spec['sampleLimit'] = $sampleLimit;
        }

        $this->configureMonitor($manifest, $spec);

        return $monitor;
    }
}
